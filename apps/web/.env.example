# Copy to .env.local for local overrides. Never commit real .env files.
# Every value here is PUBLIC (it ends up in the static site). Never put secrets in this app.

# Sub-path the site is served from.
#   - Leave empty for local development, a custom domain, or a <user>.github.io user site.
#   - For a GitHub Pages project site it is "/<repository-name>" (no trailing slash).
# CI sets this automatically from actions/configure-pages, so you normally never set it.
BASE_PATH=
